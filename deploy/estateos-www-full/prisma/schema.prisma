generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model User {
  isPro                Boolean                  @default(false)
  leadsReceived        LeadTransfer[]           @relation("LeadAgency")
  leadsOwned           LeadTransfer[]           @relation("LeadOwner")
  id                   Int                      @id @default(autoincrement())
  email                String                   @unique
  phone                String?                  @unique
  password             String?
  name                 String?
  image                String?                  @db.Text
  companyName          String?
  companyAddress       String?                  @db.VarChar(255)
  companyWebsite       String?                  @db.VarChar(255)
  companyLogoUrl       String?                  @db.VarChar(512)
  officePhone          String?                  @db.VarChar(64)
  officeEmail          String?                  @db.VarChar(191)
  nip                  String?
  role                 Role                     @default(USER)
  planType             PlanType?                @default(NONE)
  extraListings        Int                      @default(0)
  plusExpiresAt        DateTime?
  proExpiresAt         DateTime?
  isVerified           Boolean                  @default(false)
  emailVerifiedAt      DateTime?
  otpCode              String?
  otpExpiry            DateTime?
  pendingEmail         String?
  pendingEmailCode     String?
  pendingEmailExpiresAt DateTime?
  emailVerifyCode      String?
  emailVerifyExpiresAt DateTime?
  phoneVerifiedAt      DateTime?
  searchType            String?
  searchDistricts       String?
  searchMaxPrice        Int?
  searchAreaFrom        Int?
  searchAreaTo          Int?
  searchPlotArea        Int?
  searchRooms           Int?
  buyerType             String?
  searchTransactionType String?
  searchAmenities       String?
  createdAt            DateTime                 @default(now())
  updatedAt            DateTime                 @updatedAt
  lastLoginIp          String?                  @db.VarChar(64)
  lastLoginAt          DateTime?
  accounts             Account[]
  proposedAppointments Appointment[]            @relation("ProposedAppointments")
  Authenticator        Authenticator[]
  sentBids             Bid[]                    @relation("SentBids")
  dealsAsBuyer         Deal[]                   @relation("DealBuyer")
  dealsAsSeller        Deal[]                   @relation("DealSeller")
  sentDealMessages     DealMessage[]            @relation("SentDealMessages")
  contactThreadsAsLow  ContactThread[]          @relation("ContactThreadLow")
  contactThreadsAsHigh ContactThread[]          @relation("ContactThreadHigh")
  sentContactMessages  ContactMessage[]         @relation("SentContactMessages")
  offers               Offer[]
  legalVerificationRequests LegalVerificationRequest[]
  photoSessionRequests      PhotoSessionRequest[] @relation("PhotoSessionRequester")
  photoSessionsAccepted     PhotoSessionRequest[] @relation("PhotoSessionAcceptedBy")
  reviewsReceived      Review[]                 @relation("ReviewsReceived")
  reviewsGiven         Review[]                 @relation("ReviewsGiven")
  sessions             Session[]
  devices              Device[]
  notifications        Notification[]
  notificationPrefs    NotificationPreference[]
  favoriteOffers       FavoriteOffer[]
  devicePushPrefs      DevicePushPreference?
  radarPreference    RadarPreference?
  radarSearchHistory RadarSearchHistory[]
  calendarNotes      CalendarNote[]
  discoveryEvents    DiscoveryEvent[]
  discoveryProfile   DiscoveryProfile?
  discoverySessions  DiscoverySession[]
  discoveryTropes    DiscoveryTrope[]
  hostedOpenHouseEvents OpenHouseEvent[]       @relation("OpenHouseHost")
  openHouseReservations OpenHouseReservation[] @relation("OpenHouseGuest")
  hostedAuctionEvents   AuctionEvent[]         @relation("AuctionHost")
  auctionBids           AuctionBidEntry[]      @relation("AuctionBidder")
  agencyClients        AgencyClient[]           @relation("AgencyClientsOwned")
  crmProfiles          AgencyClient[]           @relation("AgencyClientLinkedUser")
  offersAsOriginalOwner Offer[]                 @relation("OfferOriginalOwner")
  ownedAgencyCompany   AgencyCompany?           @relation("AgencyCompanyOwner")
  agencyMembership     AgencyCompanyMember?     @relation("AgencyCompanyMembership")
  approvedAgencyMembers AgencyCompanyMember[] @relation("AgencyMemberApprover")
  agencyCreditsReceived AgencyCompanyCreditTransfer[] @relation("AgencyCreditRecipient")
  agencyCreditsGranted  AgencyCompanyCreditTransfer[] @relation("AgencyCreditCreator")
}

model Alert {
  id           Int      @id @default(autoincrement())
  email        String
  propertyType String   @db.Text
  district     String   @db.Text
  maxPrice     Int
  createdAt    DateTime @default(now())

  @@index([email])
  @@index([createdAt])
}

model CalendarNote {
  id     Int    @id @default(autoincrement())
  userId Int
  date   String @db.VarChar(32)
  text   String @db.Text

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, date])
  @@index([userId])
}

/// Logi unikalnych wyświetleń ofert (web/app). Bez tego wpisu Prisma mogła usuwać tabelę przy `db push`.
model OfferViewLog {
  id          BigInt   @id @default(autoincrement())
  offerId     Int
  visitorKey  String   @db.VarChar(128)
  source      String   @default("web") @db.VarChar(16)
  ip          String?  @db.VarChar(64)
  userAgent   String?  @db.VarChar(255)
  hits        Int      @default(1)
  createdAt   DateTime @default(now())
  lastSeenAt  DateTime @default(now())

  @@unique([offerId, visitorKey], map: "OfferViewLog_offerId_visitorKey_key")
  @@index([offerId, lastSeenAt], map: "OfferViewLog_offerId_lastSeenAt_idx")
}

/// Logi wizyt stron www (deduplikacja po hash + ścieżce). Bez tego wpisu Prisma mogła usuwać tabelę przy `db push`.
model PageVisitLog {
  id           BigInt   @id @default(autoincrement())
  visitorHash  String   @db.VarChar(64)
  ip           String   @db.VarChar(64)
  country      String   @default("UN") @db.VarChar(8)
  city         String?  @db.VarChar(64)
  regionName   String?  @db.VarChar(64)
  isp          String?  @db.VarChar(128)
  geoSource    String   @default("unknown") @db.VarChar(16)
  deviceType   String   @default("unknown") @db.VarChar(16)
  path         String   @default("/") @db.VarChar(191)
  userAgent    String?  @db.VarChar(255)
  userId       Int?
  createdAt    DateTime @default(now())

  @@index([path, createdAt], map: "PageVisitLog_path_createdAt_idx")
  @@index([visitorHash, createdAt], map: "PageVisitLog_hash_createdAt_idx")
  @@index([userId, createdAt], map: "PageVisitLog_userId_createdAt_idx")
}

model Offer {
  leadTransfers   LeadTransfer[]
  favoritedBy      FavoriteOffer[]
  id              Int            @id @default(autoincrement())
  title           String
  description     String?        @db.Text
  transactionType  TransactionType @default(SELL)
  propertyType     PropertyType    @default(FLAT)
  condition        PropertyCondition @default(READY)
  price           Float
  /// Kwota w walucie wpisanej przez użytkownika (alias API: priceAmount).
  priceCurrency   String         @default("PLN") @db.VarChar(8)
  /// Canonical PLN — sortowanie, filtry radaru, porównania.
  pricePln        Float?
  exchangeRateUsed Float?
  exchangeRateDate DateTime?      @db.Date
  pricePerSqm     Float?
  adminFee        Float?
  /// Prowizja agenta (% od ceny oferty), 0 lub 0,5–10 z krokiem 0,25 — informacyjnie; rozliczenia poza platformą.
  agentCommissionPercent Float?
  deposit         Float?
  area            Float
  plotArea        Float? /// Wymagane dla HOUSE i PLOT (walidacja aplikacji); nullable dla starszych rekordów.
  rooms           Int?
  floor           Int?
  totalFloors     Int?
  yearBuilt       Int?
  hasBalcony      Boolean        @default(false)
  hasElevator     Boolean        @default(false)
  hasStorage      Boolean        @default(false)
  hasParking      Boolean        @default(false)
  hasGarden       Boolean        @default(false)
  hasAirConditioning Boolean     @default(false)
  isDuplex        Boolean        @default(false)
  isFurnished     Boolean        @default(false)
  heating         String?
  city            String         @default("Warszawa")
  district        String         @default("OTHER")
  localityCountry     String?    @default("Polska") @db.VarChar(64)
  localityCountryCode String?    @default("PL") @db.VarChar(8)
  street          String?
  buildingNumber  String?
  lat             Float?
  lng             Float?
  isExactLocation Boolean        @default(true)
  images          String?        @db.Text
  videoUrl        String?
  floorPlanUrl    String?
  floorPlan3dUrl  String?
  floorPlanScanMeta String?      @db.Text
  landRegistryNumber String?        @db.VarChar(64)
  apartmentNumber    String?        @db.VarChar(32)
  legalCheckStatus String           @default("NONE") @db.VarChar(16)
  legalCheckSubmittedAt DateTime?
  legalCheckReviewedAt DateTime?
  legalCheckReviewedBy Int?
  legalCheckRejectionReason String? @db.VarChar(64)
  legalCheckRejectionText String?   @db.Text
  legalCheckOwnerNote String?       @db.Text
  isLegalSafeVerified Boolean       @default(false)
  status          OfferStatus    @default(ACTIVE)
  expiresAt       DateTime?
  promotedUntil   DateTime?
  listPricePln    Float?         /// Cena wystawienia (PLN) — punkt odniesienia dla przeceny.
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  userId          Int
  originalOwnerUserId Int?
  managementStatus String @default("SELF") @db.VarChar(24)
  deals           Deal[]
  user            User           @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalOwner   User?          @relation("OfferOriginalOwner", fields: [originalOwnerUserId], references: [id], onDelete: SetNull)
  legalVerificationRequests LegalVerificationRequest[]
  openHouseEvents OpenHouseEvent[]
  auctionEvents   AuctionEvent[]
  priceHistory    OfferPriceHistory[]
  agencyClientMatches AgencyClientMatch[]
  agencyClientsLinked AgencyClient[] @relation("AgencyClientLinkedOffer")

  @@index([userId], map: "Offer_userId_fkey")
  @@index([originalOwnerUserId])
  @@index([legalCheckStatus, legalCheckSubmittedAt])
}

model OfferPriceHistory {
  id            Int      @id @default(autoincrement())
  offerId       Int
  price         Float
  pricePln      Float
  priceCurrency String   @default("PLN") @db.VarChar(8)
  recordedAt    DateTime @default(now())
  changeType    String   @default("INITIAL") @db.VarChar(16)
  source        String?  @db.VarChar(32)

  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@index([offerId, recordedAt], map: "OfferPriceHistory_offerId_recordedAt_idx")
}

/// Kolejka / historia zgłoszeń weryfikacji prawnej (mobile). Tabela: `LegalVerificationRequest` (patrz docs/reconciliation/sql/add_legal_verification_request.sql).
model LegalVerificationRequest {
  id                 Int      @id @default(autoincrement())
  offerId            Int
  requesterId        Int
  status             String   @default("PENDING") @db.VarChar(24)
  landRegistryNumber String   @db.VarChar(128)
  apartmentNumber    String?  @db.VarChar(64)
  note               String?  @db.Text
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  offer     Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  requester User  @relation(fields: [requesterId], references: [id], onDelete: Cascade)

  @@index([status, createdAt], map: "LegalVerificationRequest_status_createdAt_idx")
  @@index([offerId], map: "LegalVerificationRequest_offerId_idx")
}

model FavoriteOffer {
  id        Int      @id @default(autoincrement())
  userId    Int
  offerId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user  User  @relation(fields: [userId], references: [id], onDelete: Cascade)
  offer Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId])
  @@index([offerId])
  @@index([userId])
}

model OpenHouseEvent {
  id          Int                 @id @default(autoincrement())
  offerId     Int
  hostUserId  Int
  title       String?             @db.VarChar(255)
  description String?             @db.Text
  visitMode   OpenHouseVisitMode  @default(FLEX)
  status      OpenHouseStatus @default(DRAFT)
  publishedAt DateTime?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  offer Offer           @relation(fields: [offerId], references: [id], onDelete: Cascade)
  host  User            @relation("OpenHouseHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  slots OpenHouseSlot[]

  @@index([offerId])
  @@index([hostUserId])
  @@index([status, publishedAt])
}

model OpenHouseSlot {
  id        Int      @id @default(autoincrement())
  eventId   Int
  startsAt  DateTime
  endsAt    DateTime
  capacity  Int      @default(8)
  createdAt DateTime @default(now())

  event        OpenHouseEvent         @relation(fields: [eventId], references: [id], onDelete: Cascade)
  reservations OpenHouseReservation[]

  @@index([eventId, startsAt])
}

model OpenHouseReservation {
  id         Int                        @id @default(autoincrement())
  slotId     Int
  userId     Int
  guestCount Int                        @default(1)
  status     OpenHouseReservationStatus @default(CONFIRMED)
  note       String?                    @db.Text
  createdAt  DateTime                   @default(now())
  updatedAt  DateTime                   @updatedAt

  slot OpenHouseSlot @relation(fields: [slotId], references: [id], onDelete: Cascade)
  user User          @relation("OpenHouseGuest", fields: [userId], references: [id], onDelete: Cascade)

  @@unique([slotId, userId])
  @@index([userId])
}

model DevicePushPreference {
  id                   Int      @id @default(autoincrement())
  userId               Int      @unique
  favoritesEnabled     Boolean  @default(true)
  notifyPriceChange    Boolean  @default(true)
  notifyDealProposals  Boolean  @default(true)
  notifyIncludeAmounts Boolean  @default(true)
  notifyStatusChange   Boolean  @default(true)
  notifyNewSimilar     Boolean  @default(true)
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model Account {
  id                String  @id @default(cuid())
  userId            Int
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
  @@index([userId], map: "Account_userId_fkey")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId], map: "Session_userId_fkey")
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Authenticator {
  credentialID         String  @unique
  userId               Int
  providerAccountId    String
  credentialPublicKey  String
  counter              Int
  credentialDeviceType String
  credentialBackedUp   Boolean
  transports           String?
  user                 User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@id([userId, credentialID])
}

model Deal {
  id            Int           @id @default(autoincrement())
  offerId       Int
  buyerId       Int
  sellerId      Int
  status        DealStatus    @default(INITIATED)
  acceptedBidId Int?          @unique
  isActive      Boolean       @default(true)
  finalizedAt   DateTime?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt
  appointments  Appointment[]
  bids          Bid[]         @relation("DealBids")
  acceptedBid   Bid?          @relation("AcceptedBid", fields: [acceptedBidId], references: [id])
  buyer         User          @relation("DealBuyer", fields: [buyerId], references: [id], onDelete: Cascade)
  offer         Offer         @relation(fields: [offerId], references: [id], onDelete: Cascade)
  seller        User          @relation("DealSeller", fields: [sellerId], references: [id], onDelete: Cascade)
  messages      DealMessage[]
  reviews       Review[]

  @@unique([offerId, buyerId])
  @@index([buyerId])
  @@index([sellerId])
  @@index([offerId])
}

model Bid {
  id             Int       @id @default(autoincrement())
  dealId         Int
  senderId       Int
  amount         Float
  message        String?   @db.Text
  status         BidStatus @default(PENDING)
  createdAt      DateTime  @default(now())
  deal           Deal      @relation("DealBids", fields: [dealId], references: [id], onDelete: Cascade)
  sender         User      @relation("SentBids", fields: [senderId], references: [id], onDelete: Cascade)
  acceptedInDeal Deal?     @relation("AcceptedBid")

  @@index([dealId])
  @@index([senderId])
}

model DealMessage {
  id         Int      @id @default(autoincrement())
  dealId     Int
  senderId   Int
  content    String   @db.Text
  attachment String?
  isRead     Boolean  @default(false)
  createdAt  DateTime @default(now())
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  sender     User     @relation("SentDealMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([senderId], map: "DealMessage_senderId_fkey")
}

model ContactThread {
  id         Int              @id @default(autoincrement())
  userLowId  Int
  userHighId Int
  createdAt  DateTime         @default(now())
  updatedAt  DateTime         @updatedAt
  userLow    User             @relation("ContactThreadLow", fields: [userLowId], references: [id], onDelete: Cascade)
  userHigh   User             @relation("ContactThreadHigh", fields: [userHighId], references: [id], onDelete: Cascade)
  messages   ContactMessage[]

  @@unique([userLowId, userHighId])
  @@index([userLowId])
  @@index([userHighId])
  @@index([updatedAt])
}

model ContactMessage {
  id         Int           @id @default(autoincrement())
  threadId   Int
  senderId   Int
  content    String        @db.Text
  attachment String?
  isRead     Boolean       @default(false)
  reactions  String?       @db.Text
  createdAt  DateTime      @default(now())
  thread     ContactThread @relation(fields: [threadId], references: [id], onDelete: Cascade)
  sender     User          @relation("SentContactMessages", fields: [senderId], references: [id], onDelete: Cascade)

  @@index([threadId])
  @@index([senderId])
}

model Appointment {
  id           Int               @id @default(autoincrement())
  dealId       Int
  proposedById Int
  proposedDate DateTime
  message      String?           @db.Text
  type         AppointmentType   @default(MEETING)
  status       AppointmentStatus @default(PENDING)
  createdAt    DateTime          @default(now())
  deal         Deal              @relation(fields: [dealId], references: [id], onDelete: Cascade)
  proposedBy   User              @relation("ProposedAppointments", fields: [proposedById], references: [id], onDelete: Cascade)

  @@index([dealId])
  @@index([proposedById], map: "Appointment_proposedById_fkey")
}

model Review {
  id         Int      @id @default(autoincrement())
  dealId     Int
  reviewerId Int
  revieweeId Int
  rating     Int
  comment    String?  @db.Text
  isAutoGenerated Boolean @default(false)
  source     String?  @db.VarChar(64)
  createdAt  DateTime @default(now())
  deal       Deal     @relation(fields: [dealId], references: [id], onDelete: Cascade)
  reviewee   User     @relation("ReviewsReceived", fields: [revieweeId], references: [id], onDelete: Cascade)
  reviewer   User     @relation("ReviewsGiven", fields: [reviewerId], references: [id], onDelete: Cascade)

  @@unique([dealId, reviewerId])
  @@unique([dealId, reviewerId, revieweeId])
  @@index([revieweeId], map: "Review_revieweeId_fkey")
  @@index([reviewerId], map: "Review_reviewerId_fkey")
}

enum Role {
  USER
  AGENT
  ADMIN
}

enum PlanType {
  NONE
  PRO
  PLUS
  AGENCY
  INVESTOR
}

enum DealStatus {
  INITIATED
  NEGOTIATION
  AGREED
  MEETING
  FINALIZED
  CANCELLED
}

enum OfferStatus {
  PENDING
  ACTIVE
  REJECTED
  ARCHIVED
  SOLD
  IN_DEAL
}

enum AppointmentStatus {
  PENDING
  ACCEPTED
  DECLINED
  RESCHEDULED
  COMPLETED
  NO_SHOW
  CANCELLED
}

enum AppointmentType {
  MEETING
  CALL
  VIDEO
}

enum BidStatus {
  PENDING
  ACCEPTED
  REJECTED
  COUNTER_OFFER
}

model LeadTransfer {
  id        Int      @id @default(autoincrement())
  offerId   Int
  ownerId   Int
  agencyId  Int
  status    String   @default("PENDING") // PENDING | ACCEPTED | REJECTED | COUNTERED
  price     Float?
  message   String?  @db.Text
  commissionRate  Float?
  commissionTerms String?  @db.Text
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  offer  Offer @relation(fields: [offerId], references: [id], onDelete: Cascade)
  owner  User  @relation("LeadOwner", fields: [ownerId], references: [id], onDelete: Cascade)
  agency User  @relation("LeadAgency", fields: [agencyId], references: [id], onDelete: Cascade)

  @@index([offerId])
  @@index([ownerId])
  @@index([agencyId])
}

enum NotificationType {
  MESSAGE
  DEAL_UPDATE
  BID_RECEIVED
  APPOINTMENT
  SYSTEM_ALERT
  AI_RADAR
  MARKETING
}

enum NotificationPriority {
  LOW
  NORMAL
  HIGH
  CRITICAL
}

enum NotificationDelivery {
  SILENT
  STANDARD
  WAKE_SCREEN
}

enum NotificationStatus {
  PENDING
  SENT
  DELIVERED
  READ
  FAILED
}

enum NotificationTargetType {
  OFFER
  DEAL
  CHAT
  USER
}

enum Platform {
  IOS
  ANDROID
  WEB
}

model Device {
  id            String   @id @default(cuid())
  userId        Int
  expoPushToken String
  platform      Platform @default(IOS)
  deviceModel   String?
  appVersion    String?
  isActive      Boolean  @default(true)
  lastSyncedAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, expoPushToken])
  @@index([userId])
}

model Notification {
  id             String  @id @default(cuid())
  userId         Int
  idempotencyKey String?

  title String
  body  String @db.Text

  type     NotificationType     @default(SYSTEM_ALERT)
  priority NotificationPriority @default(NORMAL)
  delivery NotificationDelivery @default(STANDARD)
  status   NotificationStatus   @default(PENDING)

  // UX CONTROL
  soundKey String?

  // Deep Linking
  targetType NotificationTargetType?
  targetId   String?

  // Lifecycle tracking
  sentAt        DateTime?
  deliveredAt   DateTime?
  readAt        DateTime?
  failedAt      DateTime?
  failureReason String?   @db.Text

  // System
  isArchived Boolean @default(false)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, idempotencyKey])
  @@index([userId, status])
  @@index([userId, createdAt])
}

model NotificationPreference {
  id     Int              @id @default(autoincrement())
  userId Int
  type   NotificationType

  pushEnabled  Boolean @default(true)
  emailEnabled Boolean @default(true)
  inAppEnabled Boolean @default(true)

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, type])
}

enum TransactionType {
  SELL
  RENT
}

enum PropertyType {
  FLAT
  HOUSE
  PLOT
  COMMERCIAL
}

enum PropertyCondition {
  READY
  NEEDS_RENOVATION
  DEVELOPER_STATE
  NOT_APPLICABLE
}

enum OpenHouseVisitMode {
  FLEX
  SLOT_30
  SLOT_60
}

enum OpenHouseStatus {
  DRAFT
  PUBLISHED
  CANCELLED
  COMPLETED
}

enum OpenHouseReservationStatus {
  CONFIRMED
  CANCELLED
}

enum AuctionStatus {
  DRAFT
  SCHEDULED
  LIVE
  ENDED
  CANCELLED
  SETTLED
}

enum AuctionBidStatus {
  VALID
  OUTBID
  WINNING
}

model AuctionEvent {
  id                 Int           @id @default(autoincrement())
  offerId            Int
  hostUserId         Int
  title              String?       @db.VarChar(255)
  description        String?       @db.Text
  currency           String        @default("PLN") @db.VarChar(8)
  startPrice         Float
  reservePrice       Float?
  minIncrement       Float?
  currentPrice       Float         @default(0)
  currentBidderUserId Int?
  bidCount           Int           @default(0)
  startsAt           DateTime
  endsAt             DateTime
  extendedEndsAt     DateTime?
  status             AuctionStatus @default(DRAFT)
  winnerUserId       Int?
  publishedAt        DateTime?
  createdAt          DateTime      @default(now())
  updatedAt          DateTime      @updatedAt

  offer Offer             @relation(fields: [offerId], references: [id], onDelete: Cascade)
  host  User              @relation("AuctionHost", fields: [hostUserId], references: [id], onDelete: Cascade)
  bids  AuctionBidEntry[]

  @@index([offerId])
  @@index([hostUserId])
  @@index([status, startsAt])
  @@index([status, endsAt])
}

model AuctionBidEntry {
  id        Int              @id @default(autoincrement())
  eventId   Int
  userId    Int
  amount    Float
  currency  String           @default("PLN") @db.VarChar(8)
  status    AuctionBidStatus @default(VALID)
  createdAt DateTime         @default(now())

  event AuctionEvent @relation(fields: [eventId], references: [id], onDelete: Cascade)
  user  User         @relation("AuctionBidder", fields: [userId], references: [id], onDelete: Cascade)

  @@index([eventId, createdAt])
  @@index([userId])
}

model RadarPreference {
  minMatchThreshold Int @default(70)
  id              Int   @id @default(autoincrement())
  userId          Int   @unique

  transactionType TransactionType?
  propertyType    PropertyType?

  city            String?
  districts       Json?

  maxPrice        Float?
  minArea         Float?
  minYear         Int?

  requireBalcony  Boolean @default(false)
  requireGarden   Boolean @default(false)
  requireElevator Boolean @default(false)
  requireParking  Boolean @default(false)
  requireFurnished Boolean @default(false)

  pushNotifications Boolean @default(true)

  lat             Float?
  lng             Float?
  radius          Float?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

/// Historia wyszukiwań / kalibracji radaru (jeden wiersz = jedno zdarzenie z mobile).
model RadarSearchHistory {
  id              Int              @id @default(autoincrement())
  userId          Int
  eventType       String           @default("RADAR_SEARCH") @db.VarChar(64)
  transactionType TransactionType?
  propertyType    PropertyType?
  city            String?          @db.VarChar(128)
  districts       Json?
  maxPrice        Float?
  minArea         Float?
  minYear         Int?
  requireBalcony  Boolean          @default(false)
  requireGarden   Boolean          @default(false)
  requireElevator Boolean          @default(false)
  requireParking  Boolean          @default(false)
  requireFurnished Boolean         @default(false)
  matchCount      Int?
  lat             Float?
  lng             Float?
  radius          Float?
  queryText       String?          @db.VarChar(512)
  source          String           @default("mobile") @db.VarChar(32)
  searchedAt      DateTime         @default(now())
  createdAt       DateTime         @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId, searchedAt])
  @@index([userId, createdAt])
}

model DiscoveryEvent {
  id                BigInt   @id @default(autoincrement())
  userId            Int
  sessionId         String?  @db.VarChar(64)
  idempotencyKey    String?  @unique @db.VarChar(96)
  eventType         String   @db.VarChar(64)
  offerId           Int?
  photoIndex        Int?
  score             Int?
  reasonCode        String?  @db.VarChar(64)
  visitOutcome      String?  @db.VarChar(32)
  correctionTarget  String?  @db.VarChar(128)
  dwellMs           Int?
  decisionLatencyMs Int?
  source            String   @default("mobile_discovery") @db.VarChar(32)
  platform          String   @db.VarChar(16)
  at                DateTime @default(now())
  createdAt         DateTime @default(now())

  user    User              @relation(fields: [userId], references: [id], onDelete: Cascade)
  session DiscoverySession? @relation(fields: [sessionId], references: [id], onDelete: SetNull)

  @@index([userId, createdAt], map: "DiscoveryEvent_user_created_idx")
  @@index([userId, sessionId, createdAt], map: "DiscoveryEvent_user_session_created_idx")
  @@index([userId, eventType], map: "DiscoveryEvent_user_event_idx")
  @@index([offerId, createdAt], map: "DiscoveryEvent_offer_created_idx")
}

model DiscoveryProfile {
  id                 Int      @id @default(autoincrement())
  userId             Int      @unique
  likesCount         Int      @default(0)
  dislikesCount      Int      @default(0)
  fastTrackCount     Int      @default(0)
  opensCount         Int      @default(0)
  reasonStats        Json?
  cityStats          Json?
  districtStats      Json?
  propertyStats      Json?
  tasteVector        Json?
  preferenceVector   Json?
  engineVersion      String   @default("discovery-foundation-v1") @db.VarChar(64)
  dnaVersion         String   @default("discovery-dna-v1") @db.VarChar(64)
  confidence         Float    @default(0)
  contradictionIndex Float    @default(0)
  explorationHunger  Float    @default(1)
  searchPhase        String   @default("ACTIVE") @db.VarChar(32)
  lastCorrectionAt   DateTime?
  lastVisitAt        DateTime?
  updatedAt          DateTime @updatedAt
  createdAt          DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model DiscoverySession {
  id                   String   @id @db.VarChar(64)
  userId               Int
  status               String   @default("ACTIVE") @db.VarChar(32)
  tempoMode            String   @default("NORMAL") @db.VarChar(32)
  decisionCount        Int      @default(0)
  explorationBudget    Int      @default(0)
  shownOfferIds        Json?
  undoSnapshot         Json?
  startedAt            DateTime @default(now())
  lastActivityAt       DateTime @default(now())
  endedAt              DateTime?
  createdAt            DateTime @default(now())
  updatedAt            DateTime @updatedAt

  user   User             @relation(fields: [userId], references: [id], onDelete: Cascade)
  events DiscoveryEvent[]

  @@index([userId, status, lastActivityAt], map: "DiscoverySession_user_status_activity_idx")
}

model DiscoveryEmbeddingJob {
  id           String   @id @db.VarChar(64)
  offerId      Int
  status       String   @default("PENDING") @db.VarChar(32)
  modelVersion String   @default("provider-agnostic-v1") @db.VarChar(96)
  inputHash    String?  @db.VarChar(128)
  vector       Json?
  errorCode    String?  @db.VarChar(128)
  requestedAt  DateTime @default(now())
  processedAt  DateTime?
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@unique([offerId, modelVersion], map: "DiscoveryEmbeddingJob_offer_model_key")
  @@index([status, requestedAt], map: "DiscoveryEmbeddingJob_status_requested_idx")
}

model DiscoveryGalleryPlan {
  id               String   @id @db.VarChar(64)
  offerId          Int      @unique
  algorithmVersion String   @default("gallery-foundation-v1") @db.VarChar(96)
  sourceHash       String?  @db.VarChar(128)
  orderedAssets    Json?
  assetRoles       Json?
  status           String   @default("READY") @db.VarChar(32)
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  @@index([status, updatedAt], map: "DiscoveryGalleryPlan_status_updated_idx")
}

model DiscoveryTrope {
  id           String   @id @db.VarChar(64)
  userId       Int
  offerId      Int
  status       String   @default("SAVED") @db.VarChar(32)
  priority     Boolean  @default(false)
  visitOutcome String?  @db.VarChar(32)
  note         String?  @db.VarChar(512)
  savedAt      DateTime @default(now())
  updatedAt    DateTime @updatedAt

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, offerId], map: "DiscoveryTrope_user_offer_key")
  @@index([userId, status, updatedAt], map: "DiscoveryTrope_user_status_updated_idx")
}

enum AgencyMemberRole {
  ADMIN
  AGENT
}

enum AgencyMemberStatus {
  PENDING
  ACTIVE
  REJECTED
  SUSPENDED
}

enum AgencyAgentTitle {
  DORADCA
  AGENT
  BROKER
  EXPERT
  LEADER
  KIEROWNIK_BIURO
  ZASTEPCA_KIEROWNIKA
}

/// Biuro nieruchomości — jedna firma, wielu agentów.
model AgencyCompany {
  id            Int       @id @default(autoincrement())
  name          String    @db.VarChar(191)
  slug          String?   @unique @db.VarChar(64)
  address       String?   @db.VarChar(255)
  website       String?   @db.VarChar(255)
  logoUrl       String?   @db.VarChar(512)
  officePhone   String?   @db.VarChar(64)
  officeEmail   String?   @db.VarChar(191)
  nip           String?   @db.VarChar(32)
  extraListings Int       @default(0)
  plusExpiresAt DateTime?
  ownerUserId   Int       @unique
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  owner           User                          @relation("AgencyCompanyOwner", fields: [ownerUserId], references: [id], onDelete: Cascade)
  members         AgencyCompanyMember[]
  creditTransfers AgencyCompanyCreditTransfer[]
}

model AgencyCompanyMember {
  id           Int                @id @default(autoincrement())
  companyId    Int
  userId       Int                @unique
  role         AgencyMemberRole   @default(AGENT)
  status       AgencyMemberStatus @default(PENDING)
  agentTitle   AgencyAgentTitle   @default(AGENT)
  profilePhotoUrl String?         @db.VarChar(512)
  approvedAt   DateTime?
  approvedById Int?
  createdAt    DateTime           @default(now())
  updatedAt    DateTime           @updatedAt

  company    AgencyCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user       User          @relation("AgencyCompanyMembership", fields: [userId], references: [id], onDelete: Cascade)
  approvedBy User?         @relation("AgencyMemberApprover", fields: [approvedById], references: [id], onDelete: SetNull)

  @@index([companyId, status])
}

model AgencyCompanyCreditTransfer {
  id          Int      @id @default(autoincrement())
  companyId   Int
  toUserId    Int
  amount      Int
  note        String?  @db.VarChar(255)
  createdById Int
  createdAt   DateTime @default(now())

  company   AgencyCompany @relation(fields: [companyId], references: [id], onDelete: Cascade)
  toUser    User          @relation("AgencyCreditRecipient", fields: [toUserId], references: [id], onDelete: Cascade)
  createdBy User          @relation("AgencyCreditCreator", fields: [createdById], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
  @@index([toUserId])
}

enum AgencyClientType {
  BUYER
  SELLER
}

enum AgencyClientStatus {
  ACTIVE
  ARCHIVED
}

/// Klient biura nieruchomości — poza kontem User (CRM agenta).
model AgencyClient {
  id             Int                @id @default(autoincrement())
  agencyUserId   Int
  type           AgencyClientType
  status         AgencyClientStatus @default(ACTIVE)
  firstName      String             @db.VarChar(96)
  lastName       String             @db.VarChar(96)
  email          String?            @db.VarChar(191)
  phone          String?            @db.VarChar(32)
  pesel          String?            @db.VarChar(16)
  emailVerifiedAt DateTime?
  phoneVerifiedAt DateTime?
  emailVerifyCode String?           @db.VarChar(16)
  emailVerifyExpiresAt DateTime?
  smsVerifyCode   String?           @db.VarChar(16)
  smsVerifyExpiresAt DateTime?
  notes          String?            @db.Text
  sellerTransactionType TransactionType?
  sellerPropertyType    PropertyType?
  sellerCity            String?      @db.VarChar(128)
  sellerDistrict        String?      @db.VarChar(128)
  sellerPrice           Float?
  sellerArea            Float?
  sellerRooms           Int?
  sellerDescription     String?      @db.Text
  linkedOfferId         Int?
  linkedUserId          Int?
  portalToken           String?            @unique @db.VarChar(64)
  createdAt      DateTime           @default(now())
  updatedAt      DateTime           @updatedAt

  agencyUser User @relation("AgencyClientsOwned", fields: [agencyUserId], references: [id], onDelete: Cascade)
  linkedOffer Offer? @relation("AgencyClientLinkedOffer", fields: [linkedOfferId], references: [id], onDelete: SetNull)
  linkedUser  User?  @relation("AgencyClientLinkedUser", fields: [linkedUserId], references: [id], onDelete: SetNull)
  buyerPreference AgencyClientBuyerPreference?
  matches         AgencyClientMatch[]
  activities      AgencyClientActivity[]

  @@index([agencyUserId, type, status])
  @@index([agencyUserId, updatedAt])
  @@index([linkedUserId])
}

model AgencyClientBuyerPreference {
  id                Int @id @default(autoincrement())
  clientId          Int @unique
  transactionType   TransactionType?
  propertyType      PropertyType?
  city              String?   @db.VarChar(128)
  districts         Json?
  maxPrice          Float?
  minArea           Float?
  minYear           Int?
  requireBalcony    Boolean @default(false)
  requireGarden     Boolean @default(false)
  requireElevator   Boolean @default(false)
  requireParking    Boolean @default(false)
  requireFurnished  Boolean @default(false)
  minMatchThreshold Int     @default(70)
  lat               Float?
  lng               Float?
  radius            Float?

  client AgencyClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
}

model AgencyClientMatch {
  id         Int       @id @default(autoincrement())
  clientId   Int
  offerId    Int
  score      Int
  notifiedAt DateTime?
  sharedAt   DateTime?
  clientFeedback   String?   @db.Text
  clientFeedbackAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  client AgencyClient @relation(fields: [clientId], references: [id], onDelete: Cascade)
  offer  Offer        @relation(fields: [offerId], references: [id], onDelete: Cascade)

  @@unique([clientId, offerId])
  @@index([clientId, score])
}

model AgencyClientActivity {
  id           Int      @id @default(autoincrement())
  clientId     Int
  agencyUserId Int
  kind         String   @db.VarChar(64)
  title        String?  @db.VarChar(255)
  body         String?  @db.Text
  offerId      Int?
  metadata     Json?
  createdAt    DateTime @default(now())

  client AgencyClient @relation(fields: [clientId], references: [id], onDelete: Cascade)

  @@index([clientId, createdAt])
}


model PhotoSessionRequest {
  id              Int      @id @default(autoincrement())
  userId          Int
  status          String   @default("PENDING") @db.VarChar(24)
  waitingOn       String?  @db.VarChar(16)
  proposedAt      DateTime
  note            String?  @db.Text
  propertyLabel   String?  @db.VarChar(255)
  propertyType    String?  @db.VarChar(64)
  transactionType String?  @db.VarChar(32)
  isProFree       Boolean  @default(false)
  acceptedAt      DateTime?
  acceptedById    Int?
  adminNote       String?  @db.Text
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  user       User  @relation("PhotoSessionRequester", fields: [userId], references: [id], onDelete: Cascade)
  acceptedBy User? @relation("PhotoSessionAcceptedBy", fields: [acceptedById], references: [id], onDelete: SetNull)
  events     PhotoSessionEvent[]

  @@index([status, createdAt], map: "PhotoSessionRequest_status_createdAt_idx")
  @@index([userId], map: "PhotoSessionRequest_userId_idx")
}

model PhotoSessionEvent {
  id          Int      @id @default(autoincrement())
  requestId   Int
  actorUserId Int
  action      String   @db.VarChar(24)
  proposedAt  DateTime?
  note        String?  @db.Text
  createdAt   DateTime @default(now())

  request PhotoSessionRequest @relation(fields: [requestId], references: [id], onDelete: Cascade)

  @@index([requestId, createdAt], map: "PhotoSessionEvent_requestId_createdAt_idx")
}

