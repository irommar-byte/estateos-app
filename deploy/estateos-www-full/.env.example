# --- Universal Links / App Links (produkcja na estateos.pl) ---
# Apple Developer → Membership → Team ID (10 znaków)
APPLE_TEAM_ID=

# Android: SHA-256 certyfikatu podpisu release (Google Play App Signing lub lokalny keystore).
# Kilka odcisków: rozdziel spacją lub przecinkiem.
ANDROID_SHA256_CERT_FINGERPRINT=

# KEI AMER (Centrala admin — import z amer.kei.pl)
KEI_AMER_LOGIN=
KEI_AMER_PASSWORD=
# Opcjonalnie (domyślnie 55 / 2%):
# KEI_AMER_EXPORT_USER_ID=55
# KEI_AMER_EXPORT_COMMISSION_PERCENT=2

# Opcjonalnie (domyślnie jak w aplikacji Expo):
# IOS_BUNDLE_ID=pl.estateos.app
# ANDROID_PACKAGE_NAME=pl.estateos.mobile
# ANDROID_SHA256_CERT_FINGERPRINT= — Play App signing + upload key (przecinek), np. z deployment_cert.der + Expo Keystore

# Publiczny adres serwisu (udostępnianie /o/{id}). Na produkcji ustaw np. https://estateos.pl
NEXT_PUBLIC_SITE_ORIGIN=https://estateos.pl

# Bezpośrednie pobranie Android beta (APK do instalacji na telefonie)
NEXT_PUBLIC_ANDROID_BETA_APK_URL=/downloads/estateos-android.apk
NEXT_PUBLIC_ANDROID_BETA_FILENAME=estateos-android.apk
# Opcjonalnie: AAB pod /downloads/estateos-android.aab (Play Console)
# ANDROID_BETA_APK_REDIRECT_URL=
# Opcjonalnie: link do testu wewnętrznego Google Play
NEXT_PUBLIC_ANDROID_INTERNAL_TEST_URL=https://play.google.com/apps/internaltest/4699855385179896044
