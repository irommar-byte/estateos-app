+        } else if wallCount > 0 {
+            stats += "\nJeszcze liczę obrys — prowadź wzdłuż kolejnych ścian"
+        }
+        let sectionNames = liveSectionNames(from: room)
+        if !sectionNames.isEmpty {
+            stats += "\nPomieszczenia (\(sectionNames.count)): " + sectionNames.joined(separator: ", ")
+        }
