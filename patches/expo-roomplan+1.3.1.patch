+    private func liveDimensions(from room: CapturedRoom) -> (width: Double, length: Double, height: Double)? {
+        let walls = room.walls
+        guard !walls.isEmpty else { return nil }
+        var points: [(Double, Double)] = []
+        var heights: [Double] = []
+        var wallLengths: [Double] = []
+        for wall in walls {
+            let t = wall.transform
+            let cx = Double(t.columns.3.x)
+            let cz = Double(t.columns.3.z)
+            let dirX = Double(t.columns.0.x)
+            let dirZ = Double(t.columns.0.z)
+            let len = max(Double(wall.dimensions.x), 0.35)
+            wallLengths.append(len)
+            let half = len / 2.0
+            points.append((cx - dirX * half, cz - dirZ * half))
+            points.append((cx + dirX * half, cz + dirZ * half))
+            let h = Double(wall.dimensions.y)
+            if h > 1.35 && h < 5.8 { heights.append(h) }
+        }
+        let xs = points.map { $0.0 }
+        let zs = points.map { $0.1 }
+        guard let minX = xs.min(), let maxX = xs.max(), let minZ = zs.min(), let maxZ = zs.max() else {
+            return nil
+        }
+        var sideA = maxX - minX
+        var sideB = maxZ - minZ
+        if sideA < 0.35 || sideB < 0.35 {
+            let longest = wallLengths.max() ?? 0
+            guard longest > 0.35 else { return nil }
+            let height = heights.isEmpty ? 0 : heights.reduce(0, +) / Double(heights.count)
+            return (longest, max(longest * 0.55, 0.35), height)
+        }
+        let width = min(sideA, sideB)
+        let length = max(sideA, sideB)
+        let height = heights.isEmpty ? 0 : heights.reduce(0, +) / Double(heights.count)
+        return (width, length, height)
+    }
