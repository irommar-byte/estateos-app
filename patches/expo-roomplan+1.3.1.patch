+            finishButton.isEnabled = true
+            finishButton.alpha = 1
+            finishButton.setTitle("Zakończ", for: .normal)
+        } else {
+            scanHud.backgroundColor = UIColor.black.withAlphaComponent(0.72)
+            scanHudTitle.text = "KONTROLA SKANU"
+            scanHudHint.text = "Prowadź telefon powoli wzdłuż ścian. Zakończ, gdy pojawią się wymiary."
+            finishButton.isEnabled = wallCount >= 2
+            finishButton.alpha = wallCount >= 2 ? 1 : 0.45
+            finishButton.setTitle("Zakończ", for: .normal)
+        }
+    }
