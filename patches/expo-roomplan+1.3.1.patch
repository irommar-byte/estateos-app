+        case .dishwasher: return "zmywarka"
+        case .table: return "stół"
+        case .sofa: return "sofa"
+        case .chair: return "krzesło"
+        case .fireplace: return "kominek"
+        case .television: return "TV"
+        case .stairs: return "schody"
+        @unknown default: return "mebel"
+        }
+    }
+
+    private func liveFurnitureLine(from room: CapturedRoom) -> String {
+        let names = room.objects.prefix(6).map { polishObjectName($0.category) }
+        if names.isEmpty { return "Szukam mebli i AGD stosownie do pomieszczenia…" }
+        return "Meble: " + names.joined(separator: ", ")
