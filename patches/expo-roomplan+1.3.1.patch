+        let hasFloor = !room.floors.isEmpty
+        let hasCeiling = !room.ceilings.isEmpty
+        let dims = liveDimensions(from: room)
+        let ready = wallCount >= 3 && (hasFloor || hasCeiling || (dims?.height ?? 0) > 1.8)
+
+        var stats = "Ściany \(wallCount) · drzwi \(doorCount) · okna \(windowCount) · obiekty \(objectCount)"
+        if let dims {
+            let h = dims.height > 0 ? String(format: " · H %.2f m", dims.height) : ""
+            stats += String(format: "\n%.2f × %.2f m%@", dims.width, dims.length, h)
+        }
+        stats += "\n" + liveFurnitureLine(from: room)
+        scanHudStats.text = stats
+
+        if ready {
+            scanHud.backgroundColor = UIColor(red: 0.02, green: 0.35, blue: 0.22, alpha: 0.88)
+            scanHudTitle.text = "MOŻESZ ZAKOŃCZYĆ"
+            scanHudHint.text = "Pomieszczenie jest spójne. Zakończ — wymiary i meble zapiszą się na planie."
+            finishButton.isEnabled = true
+            finishButton.alpha = 1
+            finishButton.setTitle("Zakończ i zapisz", for: .normal)
+        } else if wallCount >= 2, dims != nil {
+            scanHud.backgroundColor = UIColor(red: 0.45, green: 0.28, blue: 0.02, alpha: 0.88)
+            scanHudTitle.text = "DOKOŃCZ OBRYS"
