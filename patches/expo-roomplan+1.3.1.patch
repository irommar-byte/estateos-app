+@available(iOS 16.0, *)
+private final class LiveRoomOutlineView: UIView {
+    private let shape = CAShapeLayer()
+
+    override init(frame: CGRect) {
+        super.init(frame: frame)
+        isUserInteractionEnabled = false
+        shape.fillColor = UIColor.systemTeal.withAlphaComponent(0.18).cgColor
+        shape.strokeColor = UIColor.white.cgColor
+        shape.lineWidth = 2
+        shape.lineJoin = .round
+        layer.addSublayer(shape)
+    }
+
+    required init?(coder: NSCoder) {
+        fatalError("init(coder:) has not been implemented")
+    }
+
+    override func layoutSubviews() {
+        super.layoutSubviews()
+        shape.frame = bounds
+    }
+
+    func update(from room: CapturedRoom) {
+        var points: [CGPoint] = []
+        for wall in room.walls {
+            let t = wall.transform
+            let cx = CGFloat(t.columns.3.x)
+            let cz = CGFloat(t.columns.3.z)
+            let dirX = CGFloat(t.columns.0.x)
+            let dirZ = CGFloat(t.columns.0.z)
+            let half = CGFloat(max(wall.dimensions.x, 0.2) / 2)
+            points.append(CGPoint(x: cx - dirX * half, y: cz - dirZ * half))
+            points.append(CGPoint(x: cx + dirX * half, y: cz + dirZ * half))
+        }
+        guard points.count >= 2 else {
+            shape.path = nil
+            return
+        }
+        let xs = points.map(\.x)
+        let ys = points.map(\.y)
+        guard let minX = xs.min(), let maxX = xs.max(), let minY = ys.min(), let maxY = ys.max() else {
+            shape.path = nil
+            return
+        }
+        let spanX = max(maxX - minX, 0.4)
+        let spanY = max(maxY - minY, 0.4)
+        let inset: CGFloat = 8
+        let w = max(bounds.width - inset * 2, 1)
+        let h = max(bounds.height - inset * 2, 1)
+        let scale = min(w / spanX, h / spanY)
+        let path = UIBezierPath()
+        for (index, point) in points.enumerated() {
+            let x = inset + (point.x - minX) * scale
+            let y = inset + (point.y - minY) * scale
+            if index == 0 {
+                path.move(to: CGPoint(x: x, y: y))
+            } else {
+                path.addLine(to: CGPoint(x: x, y: y))
+            }
+        }
+        if room.walls.count >= 3 {
+            path.close()
+        }
+        shape.path = path.cgPath
     }
 }
