 @available(iOS 16.0, *)
 public class ExpoRoomPlanModule: Module {
     private var captureViewController: RoomPlanCaptureViewController?
 
+    private static func topViewController(from base: UIViewController? = nil) -> UIViewController? {
+        let resolvedBase: UIViewController?
+        if let base {
+            resolvedBase = base
+        } else {
+            let windows = UIApplication.shared.connectedScenes
+                .compactMap { $0 as? UIWindowScene }
+                .flatMap { $0.windows }
+            let key = windows.first(where: { $0.isKeyWindow }) ?? windows.first(where: { !$0.isHidden })
+            resolvedBase = key?.rootViewController
+        }
+
+        if let nav = resolvedBase as? UINavigationController {
+            return topViewController(from: nav.visibleViewController ?? nav.topViewController)
+        }
+        if let tab = resolvedBase as? UITabBarController {
+            return topViewController(from: tab.selectedViewController)
+        }
+        if let presented = resolvedBase?.presentedViewController {
+            return topViewController(from: presented)
+        }
+        return resolvedBase
+    }
+
+    private func dismissExisting(completion: @escaping () -> Void) {
+        guard let existing = captureViewController else {
+            completion()
+            return
+        }
+        existing.hardStopAR()
+        existing.onDismiss = nil
+        captureViewController = nil
+        if existing.presentingViewController != nil {
+            existing.dismiss(animated: false, completion: completion)
+        } else {
+            completion()
+        }
+    }
+
     public func definition() -> ModuleDefinition {
         Name("ExpoRoomPlan")
 
