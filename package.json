{
  "name": "apple-style-app",
  "version": "1.0.3",
  "main": "index.ts",
  "scripts": {
    "postinstall": "patch-package && bash scripts/fix-ios-pod-headers.sh",
    "ios:prepare": "bash scripts/ios-prepare-build.sh",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "lint": "expo lint",
    "test:contracts": "tsx --test tests/contracts/*.test.ts",
    "test:catalog-pins": "tsx --test tests/utils/offer-catalog-pins.test.ts",
    "test:android-smoke": "tsx --test tests/utils/offer-catalog-pins.test.ts && tsx scripts/smoke-android-release.mjs",
    "verify:ios-release": "node scripts/embed-git-sha.mjs && node scripts/verify-ios-release-bundle.mjs export",
    "verify:ios-archive": "node scripts/verify-ios-release-bundle.mjs archive",
    "prearchive:ios": "npm run verify:ios-release",
    "eas:ios": "eas build --platform ios --profile production",
    "eas:ios:submit": "eas submit --platform ios --latest",
    "eas:ios:all": "eas build --platform ios --profile production --auto-submit",
    "eas:android": "eas build --platform android --profile production-android",
    "eas:android:preview": "eas build --platform android --profile preview-android",
    "eas:android:submit": "eas submit --platform android --profile production-android --latest",
    "prebuild:android": "expo prebuild --platform android --clean"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.3",
    "@magrinj/expo-quick-look": "^0.4.0",
    "@react-native-async-storage/async-storage": "^2.2.0",
    "@react-native-masked-view/masked-view": "^0.3.2",
    "@react-native-picker/picker": "2.11.1",
    "@react-navigation/bottom-tabs": "^7.15.9",
    "@react-navigation/native": "^7.2.2",
    "@react-navigation/native-stack": "^7.14.10",
    "@supabase/auth-js": "^2.64.0",
    "@supabase/supabase-js": "^2.39.3",
    "expo": "~54.0.33",
    "expo-av": "~16.0.8",
    "expo-blur": "~15.0.8",
    "expo-build-properties": "~1.0.10",
    "expo-calendar": "~15.0.8",
    "expo-camera": "~17.0.10",
    "expo-constants": "~18.0.13",
    "expo-dev-client": "~6.0.20",
    "expo-device": "~8.0.10",
    "expo-document-picker": "~14.0.8",
    "expo-file-system": "~19.0.22",
    "expo-font": "~14.0.11",
    "expo-haptics": "~15.0.8",
    "expo-image": "~3.0.11",
    "expo-image-manipulator": "~14.0.8",
    "expo-image-picker": "~17.0.10",
    "expo-linear-gradient": "~15.0.8",
    "expo-local-authentication": "~17.0.8",
    "expo-localization": "~17.0.8",
    "expo-location": "~19.0.8",
    "expo-notifications": "~0.32.16",
    "expo-status-bar": "~3.0.9",
    "expo-store-review": "~9.0.9",
    "libphonenumber-js": "^1.13.1",
    "lucide-react-native": "^1.8.0",
    "react": "19.1.0",
    "react-native": "0.81.5",
    "react-native-draggable-flatlist": "^4.0.3",
    "react-native-gesture-handler": "~2.28.0",
    "react-native-iap": "^14.7.3",
    "react-native-image-viewing": "^0.2.2",
    "react-native-map-clustering": "^4.0.0",
    "react-native-maps": "1.20.1",
    "react-native-nitro-modules": "^0.35.5",
    "react-native-passkey": "^3.3.3",
    "react-native-reanimated": "~4.1.1",
    "react-native-safe-area-context": "~5.6.0",
    "react-native-screens": "~4.16.0",
    "react-native-svg": "15.12.1",
    "react-native-url-polyfill": "^3.0.0",
    "react-native-webview": "13.15.0",
    "react-native-worklets": "0.5.1",
    "zustand": "^5.0.12"
  },
  "devDependencies": {
    "@expo/ngrok": "^4.1.3",
    "@react-native-community/cli": "^20.1.3",
    "@types/react": "~19.1.0",
    "babel-preset-expo": "~54.0.10",
    "eslint": "^9.0.0",
    "eslint-config-expo": "~10.0.0",
    "patch-package": "^8.0.1",
    "tsx": "^4.21.0",
    "typescript": "~5.9.2"
  },
  "private": true
}
