{
  "cli": {
    "version": ">= 18.5.0",
    "appVersionSource": "remote"
  },
  "build": {
    "development": {
      "developmentClient": true,
      "distribution": "internal"
    },
    "preview": {
      "distribution": "internal"
    },
    "production": {
      "autoIncrement": true
    },
    "production-android": {
      "extends": "production",
      "android": {
        "buildType": "app-bundle",
        "credentialsSource": "remote",
        "keystoreName": "GPLAY"
      }
    },
    "preview-android": {
      "extends": "preview",
      "android": {
        "buildType": "apk"
      }
    }
  },
  "submit": {
    "production": {},
    "production-android": {
      "android": {
        "track": "internal"
      }
    }
  }
}
